# ── Secrets / credentials (defensive — never commit these) ──────────────
# config.env is intentionally tracked (it holds only knobs + pinned digests,
# no secrets). These patterns stop an accidental `git add .` leaking keys.
*.pem
*.key
.env
.env.*
*credentials*
*.crt

# ── Local/Mac test artifacts (superseded by results/runs-aws.csv) ───────
results/runs.csv
results/summary.csv
results/report.md
results/dress-rehearsal.log
results/*.json
results/.cluster-entry

# ── PRIVATE: go-redis collaboration data (unreleased feature, Nedyalko) ──
# Do NOT publish until the go-redis autopipeline feature ships or he OKs it.
# The explorer hides its go-redis chart automatically when this file is absent,
# so the deployed/public explorer stays clean without code changes.
results/runs-goredis.csv
results/goredis-json/

# ── cruft ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
