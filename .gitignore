# ── Secrets / credentials (defensive — never commit these) ──────────────
# config.env is intentionally tracked (it holds only knobs + pinned digests,
# no secrets). These patterns stop an accidental `git add .` leaking keys.
*.pem
*.key
.env
.env.*
*credentials*
*.crt

# ── Local/Mac test artifacts (superseded by results/runs-aws.csv) ───────
results/runs.csv
results/summary.csv
results/report.md
results/dress-rehearsal.log
results/*.json
results/.cluster-entry

# ── PRIVATE: third-party client dataset, shared in confidence ───────────
# Do NOT publish until the upstream maintainer confirms it is fine to.
# The explorer hides this chart automatically when the file is absent,
# so the deployed/public explorer stays clean without code changes.
results/runs-clientsweep.csv
results/clientsweep-json/

# ── cruft ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
