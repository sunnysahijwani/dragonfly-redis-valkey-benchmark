# ============================================================================
# Dragonfly vs Redis vs Valkey — benchmark config
# Every value is OVERRIDABLE from the environment, so you can tweak + re-run
# without editing this file, e.g.:
#     SERVER_THREADS=8 SHARDS=8 PIPELINES="1 32" bash scripts/run-phase-a.sh
# The ':=' means "use this default only if not already set in the environment".
# ============================================================================

# --- Pinned images by MULTI-ARCH INDEX digest (verified amd64 + arm64) --------
# Pinning the index digest (not a per-arch manifest) means the SAME reference
# resolves correctly on the arm64 Mac (Phase A) AND the amd64 AWS box (Phase B).
# Tag kept for readability; the @sha256 digest is what actually pins.
: "${IMG_REDIS:=redis:8.2@sha256:2f7462b9e93e0a7ae2edf3a0a0babc8a4d29f8bfc50849b906b7caaef925edc1}"                                  # v8.2.8
: "${IMG_VALKEY:=valkey/valkey:8.1@sha256:495e4fecdc98ee48a20b207726caa5ab6451e0fac3642a9be10d9e70b3068df6}"                        # v8.1.9
: "${IMG_DRAGONFLY:=ghcr.io/dragonflydb/dragonfly:latest@sha256:ebf3c6c213e82fb51b4521660cca13f06f3421dc5b1ed14f2f474c50b5e29986}"  # v1.40.1
: "${IMG_MEMTIER:=redislabs/memtier_benchmark:latest@sha256:5f15b74f657fd30ee73453af9caa1781de1614f4d934d46feee711dc19b758af}"      # v2.5.1

# --- Docker network ----------------------------------------------------------
: "${NET:=bench-net}"
# HOST_NET=1 => engines/memtier use the HOST network stack instead of a docker
# bridge. Needed on bare metal for: (a) single-box loopback (client+engine on
# one box, pinned to disjoint cores), and (b) two-box (engine on server, memtier
# on client, over the private network). ANNOUNCE_IP is the address a cluster
# advertises — 127.0.0.1 for single-box, the SERVER's private IP for two-box.
: "${HOST_NET:=0}"
: "${ANNOUNCE_IP:=127.0.0.1}"

# --- CPU budget --------------------------------------------------------------
# PHASE A (this Mac): pins map to Docker's Linux-VM vCPUs, NOT host physical
# cores. Fine for harness validation + cross-slot story; NOT valid for the
# published core-scaling curve.
# PHASE B (bare metal): real physical cores on ONE NUMA node (`lscpu -e`).
# DF gets the LOW cores (Oded #3). CLIENT must be OVER-provisioned (its own
# bigger box) so it is never the bottleneck — see scripts/ramp.sh.
: "${SERVER_CPUS:=0-3}"        # engine under test
: "${CLIENT_CPUS:=4-7}"        # memtier
: "${SERVER_THREADS:=4}"       # DF proactor_threads / single-node Redis|Valkey io-threads

# --- Cluster shape (the fair per-node peer for one DF process) ---------------
: "${SHARDS:=$SERVER_THREADS}"     # number of Redis/Valkey shards in the cluster
: "${SHARD_IO_THREADS:=1}"         # io-threads PER shard (1 = one core each).
                                   # FAIRNESS KNOB: sweep SHARDS x SHARD_IO_THREADS
                                   # to find Redis's BEST layout, not just the first.

# --- Memory ------------------------------------------------------------------
: "${MAXMEMORY:=4gb}"          # keep well above dataset so we measure the engine

# --- Workload matrix ---------------------------------------------------------
: "${TEST_TIME:=30}"           # seconds per run (Phase A smoke used 12)
: "${CLIENT_THREADS:=4}"
: "${CLIENT_CONNS:=25}"        # per thread
: "${DATA_SIZES:=100 1024}"    # value bytes
: "${PIPELINES:=1 16}"         # depth-1 = latency-honest, 16 = throughput-honest
: "${KEY_MAX:=1000000}"        # keyspace
: "${RATIOS:=1:10 1:1}"        # SET:GET — read-heavy, mixed

# --- Multi-key workloads (MGET/MSET) -----------------------------------------
# DF claims its biggest wins on multi-key commands. In a CLUSTER, N distinct
# keys hash to different slots => CROSSSLOT, so multi-key is a SINGLE-NODE
# comparison (which is exactly what DF's per-command benchmark page publishes).
# The cluster's inability is the operational story (see crossslot.sh).
: "${MULTIKEY:=0}"             # 1 = also run MGET/MSET (single-node engines only)
: "${MULTIKEY_N:=10}"          # keys per multi-key command

# --- Correctness -------------------------------------------------------------
: "${POPULATE:=1}"             # 1 = preload keyspace so GETs HIT (fixes miss-rate)
: "${REPS:=1}"                 # repetitions per cell (raise to 3+ for capture)

# --- Run identity (stamped into results/runs.csv for later comparison) -------
: "${RUN_NOTE:=}"              # free-text label for this batch, e.g. "shard-sweep"

RESULTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/results"
